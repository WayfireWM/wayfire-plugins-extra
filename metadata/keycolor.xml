<?xml version="1.0"?>
<wayfire>
	<plugin name="keycolor">
		<_short>Keycolor</_short>
		<category>Effects</category>
		<option name="color" type="color">
			<_short>Key Color</_short>
			<default>0 0 0 1</default>
		</option>
		<option name="opacity" type="double">
			<_short>Opacity</_short>
			<default>0.25</default>
		</option>
		<option name="threshold" type="double">
			<_short>Threshold</_short>
			<default>0.5</default>
		</option>
		<option name="enabled_for" type="string">
			<_short>Keycolor enabled for specified windows</_short>
			<_long>Specifies the windows for which the keycolor effect is enabled.</_long>
			<default>type equals "toplevel"</default>
		</option>
	</plugin>
</wayfire>
